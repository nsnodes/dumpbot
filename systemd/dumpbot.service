[Unit]
Description=DumpBot Telegram Link Collector
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/dumpbot
Environment=PATH=/root/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/root/.local/bin/uv run dumpbot
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
